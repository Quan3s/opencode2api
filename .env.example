# ==== Bridge public facing ====
HOST=0.0.0.0
PORT=8080
# Để trống = không cần key khi gọi bridge (chỉ dùng cho localhost/dev)
CLIENT_API_KEY=changeme-local-key

# ==== Chế độ ====
# opencode       = dịch sang HTTP API của OpenCode (opencode serve, mặc định :4096)
# opencode_free  = tái tạo request CLI free của OpenCode, không cần opencode serve
# openai         = forward tới gateway đã nói OpenAI API (opencode2api, OpenCode inference...)
UPSTREAM_MODE=opencode

# ==== Mode: opencode ====
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_API_KEY=
OPENCODE_PROVIDER_ID=opencode
DEFAULT_MODEL=big-pickle
APPEND_ASSISTANT_CUE=true
STREAM_CHUNK_CHARS=12

# ==== Mode: opencode_free (không cần opencode serve) ====
# OPENCODE_FREE_BASE_URL=https://opencode.ai/inference
# UPSTREAM_API_KEY=public
# UPSTREAM_USER_AGENT=opencode/latest/2.3.0/cli
# Bun transport (tránh 429 do TLS fingerprint); để trống nếu bun đã có trong PATH
# O2A_BUN=/root/.bun/bin/bun

# ==== Mode: openai (opencode2api) ====
# UPSTREAM_BASE_URL=http://127.0.0.1:8081/v1
# UPSTREAM_API_KEY=O2P-xxxxxxxx
# UPSTREAM_USER_AGENT=opencode/latest/2.3.0/cli

# Alias model: client gửi tên bên trái, bridge đổi sang tên bên phải
# MODEL_MAP={"gpt-4o":"big-pickle","claude-sonnet-4-5":"glm-5.3-flash"}

REQUEST_TIMEOUT=180
